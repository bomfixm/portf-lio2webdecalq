# URL absoluta do deploy, sem barra final (metadata, sitemap, canonical).
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com
# WhatsApp da Decalq: país + DDD + número, só dígitos (ex.: 5511999999999).
NEXT_PUBLIC_WHATSAPP=
# Opcional: número usado nas prospecções (?origem=whatsapp). Vazio = usa o acima.
NEXT_PUBLIC_WHATSAPP_PROSPECCAO=
# Opcional: e-mail de contato (aparece como alternativa discreta).
NEXT_PUBLIC_EMAIL=
